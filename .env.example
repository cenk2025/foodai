# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: DeepSeek AI for smart search suggestions
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Direct ordering (restaurant pages, cart, checkout). Off unless "true".
NEXT_PUBLIC_DIRECT_ORDERING_ENABLED=false

# Admin panel (server-only)
# Email of the Supabase Auth user that may log in to /admin. The password is
# that user's Supabase password (use "forgot password" to set it).
ADMIN_EMAIL=admin@example.com
# Random secret (>= 32 chars) used to sign the admin session cookie.
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Payments (Shopify) — leave empty to run in simulation mode
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=

# Delivery (Uber Direct) — leave empty to run in simulation mode
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
UBER_DIRECT_CUSTOMER_ID=
UBER_DIRECT_BASE_URL=

# AI (build.nvidia.com, OpenAI-compatible API). Server-only: never NEXT_PUBLIC_.
NVIDIA_API_KEY=
# Optional overrides
AI_MODEL=meta/llama-3.3-70b-instruct
AI_BASE_URL=https://integrate.api.nvidia.com/v1
